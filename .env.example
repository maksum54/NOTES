# ============================================================
#  NOTES - Engineering Project Notes PWA
#  Salin file ini jadi .env.local lalu isi value asli.
#  .env.local TIDAK PERNAH di-commit (lihat .gitignore).
# ============================================================

# --- AI (vikey.ai, OpenAI-compatible chat completions) --------
# Base URL endpoint AI. Default sudah benar, ubah hanya kalau perlu.
VITE_VIKEY_BASE_URL=https://api.vikey.ai/v1
# Model ID yang dipakai untuk review standard & chat task.
VITE_VIKEY_MODEL=gpt-4o-mini
# OPSIONAL. API key default untuk development lokal saja.
# Di production JANGAN diisi di sini -- user memasukkan key sendiri
# lewat halaman Settings (tersimpan di localStorage browser masing-masing),
# supaya key tidak ikut ter-bundle ke JS publik.
VITE_VIKEY_API_KEY=

# --- Google Drive + Google Sign-In ----------------------------
# OAuth 2.0 Client ID (tipe: Web application) dari Google Cloud Console.
# Ini memang aman diekspos di client-side (bukan client secret).
# Tambahkan domain Vercel + http://localhost:5173 ke Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
